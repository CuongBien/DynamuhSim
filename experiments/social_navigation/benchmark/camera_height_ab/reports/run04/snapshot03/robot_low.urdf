<robot name="mecanum_robot">
  <link name="base_footprint" />
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.01598" ixy="0" ixz="0" iyy="0.02473" iyz="0" izz="0.03700" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.20 0.08" />
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.35 0.65 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.20 0.08" />
      </geometry>
    </collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.04" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.06" rpy="0 0 0" />
  </joint>
  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04" />
      </geometry>
      <material name="dark">
        <color rgba="0.1 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04" />
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_scan" />
    <origin xyz="0 0 0.12" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025" />
      </geometry>
      <material name="grey">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz=".12 0 0.08" rpy="0 0 0" />
  </joint>
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_left_wheel" />
    <origin xyz="0.08 0.10 0.0" rpy="-1.5707963 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_right_wheel" />
    <origin xyz="0.08 -0.10 0.0" rpy="-1.5707963 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel" />
    <origin xyz="-0.08 0.10 0.0" rpy="-1.5707963 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03" />
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel" />
    <origin xyz="-0.08 -0.10 0.0" rpy="-1.5707963 0 0" />
    <axis xyz="0 0 1" />
  </joint>
</robot>