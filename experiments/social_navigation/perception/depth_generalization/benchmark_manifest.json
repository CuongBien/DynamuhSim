{
  "schema": "depth_cross_domain_mini_benchmark/1",
  "purpose": "Prepare data contract; not a claimed cross-domain experiment",
  "input_constraints": {
    "rgb": false,
    "camera_height_reference_m": 0.08,
    "lidar_height_reference_m": 0.12,
    "depth_width": 424,
    "depth_height": 240,
    "depth_unit": "m",
    "lidar_unique_rays": 359
  },
  "split_policy": "Disjoint scene geometry and human morphology across train, validation, test; no frame/window overlap; texture-only variants same family",
  "controls": "Every split includes no-person clutter/curved-object cases; missing detections cannot masquerade as good precision",
  "annotation_policy": "Use instance pixel ownership/verified masks, not nearest simulator center or current detector predictions",
  "sensor_variation": [
    "measured dropout/noise",
    "distance and partial visibility",
    "calibration profiles recorded, no hidden coordinate fitting"
  ],
  "test_policy": "Freeze one validation-selected model + preprocessing + threshold before metrics/previews on test; test once",
  "external_test_tracks": [
    "Real depth: SDT compatibility review only; not downloaded, elevated camera mismatch needs verification",
    "Real 2D LiDAR: DROW/JRDB development and FROG cross-dataset track only for LiDAR-specific models; not substitute for depth test"
  ],
  "optional_backend_test": "Repeat held-out C1/narrow layout in MuJoCo after its adapter passes; do not call this collected now",
  "local_recordings_role": "Both old pilot episodes and old same-avatar corpus are opened development/regression only",
