[env]
time_limit = 30.0
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = false

[sim]
train_val_sim = hallway_bottleneck
test_sim = hallway_bottleneck
starts_moving = 0
square_width = 5
circle_radius = 2.5
rect_width = 3
rect_height = 5
human_num = 3

[humans]
visible = true
policy = sfm
radius = .30
sensor = coordinates
safety_space = 0.01
v_pref = 1.0
a = 3.0
b = 0.18
ki = 1.0
a_static = 2.0
b_static = 0.025
a_bottleneck = 6.0
b_bottleneck = 0.12

[robot]
visible = true
policy = dwa
radius = 0.25
v_pref = 1.0
sensor = coordinates
debug = true

[reward]
success_reward = 1
collision_penalty = -0.25
freezing_penalty = -0.125
discomfort_dist = 0.2
discomfort_penalty_factor = 0.5

