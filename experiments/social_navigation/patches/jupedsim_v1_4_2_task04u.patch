+bool JPS_Simulation_RegisterExternalActor(
+    JPS_Simulation handle, double radius, double anticipationTime, JPS_AgentId* id,
+    JPS_ErrorMessage* error)
+{
+    return CoupledCall(error, [&] {
+        if(!handle || !id) {
+            throw SimulationError("invalid external actor registration arguments");
+        }
+        *id = reinterpret_cast<Simulation*>(handle)
+                  ->RegisterExternalActor(radius, anticipationTime).getID();
+    });
+}
+
+bool JPS_Simulation_ApplyCoupledState(
+    JPS_Simulation handle, uint64_t timestampNs, uint64_t steps,
+    const JPS_CoupledAgentState* external, size_t externalCount,
+    const JPS_CoupledAgentState* pedestrians, size_t pedestrianCount,
+    JPS_ErrorMessage* error)
+{
+    return CoupledCall(error, [&] {
+        if(!handle || (!external && externalCount) || (!pedestrians && pedestrianCount)) {
+            throw SimulationError("invalid coupled state arguments");
+        }
+        reinterpret_cast<Simulation*>(handle)->ApplyCoupledState(
+            timestampNs, steps, CoupledStates(external, externalCount),
+            CoupledStates(pedestrians, pedestrianCount));
+    });
+}
+
+bool JPS_Simulation_GetExternalActor(
+    JPS_Simulation handle, JPS_AgentId id, JPS_CoupledAgentState* state, double* radius,
+    uint64_t* timestampNs, JPS_ErrorMessage* error)
+{
+    return CoupledCall(error, [&] {
+        if(!handle || !state || !radius || !timestampNs) {
+            throw SimulationError("invalid external actor readback arguments");
+        }
+        const auto simulation = reinterpret_cast<const Simulation*>(handle);
+        const auto& actor = simulation->ExternalActor(GenericAgent::ID{id});
+        auto velocity = simulation->ExternalSample(actor.id).velocity;
+        if(const auto* sfm = std::get_if<SocialForceModelData>(&actor.model)) {
+            velocity = sfm->velocity;
+            *radius = sfm->radius;
+        } else if(const auto* avm = std::get_if<AnticipationVelocityModelData>(&actor.model)) {
+            velocity = avm->velocity;
+            *radius = avm->radius;
+        } else {
+            *radius = std::get<CollisionFreeSpeedModelV2Data>(actor.model).radius;
+        }
+        *state = {id, intoJPS_Point(actor.pos), intoJPS_Point(velocity),
+                  std::atan2(actor.orientation.y, actor.orientation.x)};
+        *timestampNs = simulation->CoupledSampleTimeNs();
+    });
+}
