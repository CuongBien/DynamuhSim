+bool CoupledSfmCall(JPS_ErrorMessage* error, auto operation)
+{
+    try {
+        operation();
+        return true;
+    } catch(const std::exception& ex) {
+        if(error) {
+            *error = reinterpret_cast<JPS_ErrorMessage>(new JPS_ErrorMessage_t{ex.what()});
+        }
+    } catch(...) {
+        if(error) {
+            *error = reinterpret_cast<JPS_ErrorMessage>(
+                new JPS_ErrorMessage_t{"Unknown SFM synchronization error."});
+        }
+    }
+    return false;
+}
+
+std::vector<SfmCoupledState> CoupledStates(const JPS_SfmCoupledState* states, size_t count)
+{
+    std::vector<SfmCoupledState> result;
+    result.reserve(count);
+    for(size_t i = 0; i < count; ++i) {
+        const auto& state = states[i];
+        result.push_back({
+            GenericAgent::ID{state.id}, intoPoint(state.position), intoPoint(state.velocity)});
+    }
+    return result;
+}
+}
+
+bool JPS_Simulation_RegisterExternalSfmActor(
+    JPS_Simulation handle, double radius, JPS_AgentId* id, JPS_ErrorMessage* error)
+{
+    return CoupledSfmCall(error, [&] {
+        if(!handle || !id) {
+            throw SimulationError("invalid external SFM registration arguments");
+        }
+        *id = reinterpret_cast<Simulation*>(handle)->RegisterExternalSfmActor(radius).getID();
+    });
+}
+
+bool JPS_Simulation_ApplySfmCoupledState(
+    JPS_Simulation handle,
+    uint64_t timestampNs,
+    uint64_t steps,
+    const JPS_SfmCoupledState* external,
+    size_t externalCount,
+    const JPS_SfmCoupledState* pedestrians,
+    size_t pedestrianCount,
+    JPS_ErrorMessage* error)
+{
+    return CoupledSfmCall(error, [&] {
+        if(!handle || (!external && externalCount) || (!pedestrians && pedestrianCount)) {
+            throw SimulationError("invalid SFM synchronization arguments");
+        }
+        reinterpret_cast<Simulation*>(handle)->ApplySfmCoupledState(
+            timestampNs,
+            steps,
+            CoupledStates(external, externalCount),
+            CoupledStates(pedestrians, pedestrianCount));
+    });
+}
+
+bool JPS_Simulation_GetExternalSfmActor(
+    JPS_Simulation handle,
+    JPS_AgentId id,
+    JPS_SfmCoupledState* state,
+    double* radius,
+    uint64_t* timestampNs,
+    JPS_ErrorMessage* error)
+{
+    return CoupledSfmCall(error, [&] {
+        if(!handle || !state || !radius || !timestampNs) {
+            throw SimulationError("invalid external SFM readback arguments");
+        }
+        const auto simulation = reinterpret_cast<const Simulation*>(handle);
+        const auto& actor = simulation->ExternalSfmActor(GenericAgent::ID{id});
+        const auto& model = std::get<SocialForceModelData>(actor.model);
+        *state = {id, intoJPS_Point(actor.pos), intoJPS_Point(model.velocity)};
+        *radius = model.radius;
+        *timestampNs = simulation->SfmSampleTimeNs();
+    });
+}
