<?xml version="1.0"?>
<sdf version="1.9">
  <world name="corridor_0.90">

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Physics -->
    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics"/>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands"/>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Sensors -->
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- Ground -->
    <model name="ground">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>34.0 10.0 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>34.0 10.0 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0.0 0.0 -0.05 0 0 0</pose>
    </model>


    <!-- Left continuous wall -->
    <model name="left_wall">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30.0 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30.0 0.1 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0.0 -0.5 1.0 0 0 0</pose>
    </model>


    <!-- Right wall: segment before recess -->
    <model name="right_wall_front">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16.4 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>16.4 0.1 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-6.800000000000001 0.5 1.0 0 0 0</pose>
    </model>


    <!-- Right wall: segment after recess -->
    <model name="right_wall_back">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12.4 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>12.4 0.1 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>8.8 0.5 1.0 0 0 0</pose>
    </model>


    <!-- Recess side walls -->
    <model name="recess_side_left">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>1.3499999999999999 0.75 1.0 0 0 0</pose>
    </model>


    <model name="recess_side_right">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>2.65 0.75 1.0 0 0 0</pose>
    </model>


    <!-- Recess back wall -->
    <model name="recess_back">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 0.1 2.0</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>2.0 1.1 1.0 0 0 0</pose>
    </model>


    <!-- ===================================================== -->
    <!-- Realistic 3D Animated Walking Human Pedestrian        -->
    <!-- ===================================================== -->
    <actor name="human_actor">
      <skin>
        <filename>model://human/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="1.0">
          <!-- Forward walk: 5.0 -> -1.0 at 0.8 m/s (t = 0.0 to 7.5s, strictly yaw = 3.14159) -->
          <waypoint>
            <time>0.0</time>
            <pose>5.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>1.0</time>
            <pose>4.2 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>2.0</time>
            <pose>3.4 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>3.0</time>
            <pose>2.6 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>4.0</time>
            <pose>1.8 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>5.0</time>
            <pose>1.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>6.0</time>
            <pose>0.2 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>7.0</time>
            <pose>-0.6 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>7.5</time>
            <pose>-1.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>7.6</time>
            <pose>-1.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <!-- Smooth turnaround in place at x = -1.0 (t = 7.6 to 8.9s) -->
          <waypoint>
            <time>7.9</time>
            <pose>-1.0 0.0 1.0 0 0 2.3562</pose>
          </waypoint>
          <waypoint>
            <time>8.2</time>
            <pose>-1.0 0.0 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>8.5</time>
            <pose>-1.0 0.0 1.0 0 0 0.7854</pose>
          </waypoint>
          <waypoint>
            <time>8.8</time>
            <pose>-1.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>8.9</time>
            <pose>-1.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>9.0</time>
            <pose>-1.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <!-- Return walk: -1.0 -> 5.0 at 0.8 m/s (t = 9.0 to 16.5s, strictly yaw = 0.0) -->
          <waypoint>
            <time>10.0</time>
            <pose>-0.2 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>11.0</time>
            <pose>0.6 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>12.0</time>
            <pose>1.4 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>13.0</time>
            <pose>2.2 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>14.0</time>
            <pose>3.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>15.0</time>
            <pose>3.8 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>16.0</time>
            <pose>4.6 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>16.5</time>
            <pose>5.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>16.6</time>
            <pose>5.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <!-- Smooth turnaround in place at x = 5.0 (t = 16.6 to 17.9s) -->
          <waypoint>
            <time>16.9</time>
            <pose>5.0 0.0 1.0 0 0 0.7854</pose>
          </waypoint>
          <waypoint>
            <time>17.2</time>
            <pose>5.0 0.0 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>17.5</time>
            <pose>5.0 0.0 1.0 0 0 2.3562</pose>
          </waypoint>
          <waypoint>
            <time>17.8</time>
            <pose>5.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>17.9</time>
            <pose>5.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>18.0</time>
            <pose>5.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Physical collision & ground-truth tracking for Nav2 / LiDAR -->
    <model name="dynamic_obstacle">
      <pose>5.0 0.0 0.85 0 0 3.14159</pose>
      <self_collide>false</self_collide>

      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>

      <plugin filename="liboscillating_obstacle_system.so"
              name="custom_corridor::OscillatingObstacle">
        <min_x>-1.0</min_x>
        <max_x>5.0</max_x>
        <speed>0.8</speed>
        <y>0.0</y>
        <z>0.85</z>
        <default_mode>human</default_mode>
      </plugin>
    </model>

    <!-- Physical Industrial Object (Cylinder / Pillar for Object mode) -->
    <model name="dynamic_object">
      <pose>5.0 0.0 -50.0 0 0 3.14159</pose>
      <self_collide>false</self_collide>

      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Main pillar body: Industrial Safety Orange -->
        <visual name="body_visual">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.50</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.0 1</ambient>
            <diffuse>1.0 0.45 0.05 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>

        <!-- Top industrial beacon / cap -->
        <visual name="cap_visual">
          <pose>0 0 0.80 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.23</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>

        <!-- Warning hazard band -->
        <visual name="band_visual">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.225</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>