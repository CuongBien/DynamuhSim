<?xml version="1.0"?>
<sdf version="1.9">
  <world name="arena_rvo2">

    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- High-Throughput Social Navigation with RVO2 / ORCA -->
    <plugin
        filename="librvo2_human_system.so"
        name="custom_corridor::RVO2HumanSystem">
      <human_count>4</human_count>
      <robot_name>burger</robot_name>
      <robot_radius>0.35</robot_radius>
      <human_radius>0.28</human_radius>
      <proxemic_margin_front>1.5</proxemic_margin_front>
      <proxemic_margin_side>0.7</proxemic_margin_side>
      <reaction_latency>0.3</reaction_latency>
      <social_yield_distance>3.5</social_yield_distance>
      <max_speed>0.85</max_speed>
      <time_step>0.004</time_step>
      <neighbor_dist>12.0</neighbor_dist>
      <max_neighbors>10</max_neighbors>
      <time_horizon>4.0</time_horizon>
      <time_horizon_obst>3.0</time_horizon_obst>
      <scenario_topic>/rvo2_human/scenario</scenario_topic>
      <command_topic>/rvo2_human/command</command_topic>
      <ground_truth_topic>/rvo2_human/ground_truth</ground_truth_topic>
      <proxy_z>0.85</proxy_z>
      <visual_z>1.0</visual_z>
      <animation_speed_factor>4.1534</animation_speed_factor>
    </plugin>

    <!-- Scene and Physics Optimization for RTX 4060 -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sensors -->
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
        filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>24.0 14.0 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>24.0 14.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 0.0 -0.05 0 0 0</pose>
    </model>

    <!-- Perimeter Boundary Walls (10m wide, 20m long) -->
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-15.0 0.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>5.0 0.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20.2 0.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20.2 0.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 -5.1 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20.2 0.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20.2 0.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 5.1 1.0 0 0 0</pose>
    </model>

    <!-- Interior Static Obstacles -->
    <model name="static_box_A">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 1.0 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-8.0 2.0 1.0 0 0 0</pose>
    </model>

    <model name="static_cylinder_B">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.5</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.5</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-8.0 -2.0 1.0 0 0 0</pose>
    </model>

    <!-- ============================================================== -->
    <!-- DUAL-LAYER HUMAN AGENTS (Animated 3D Visual Actor + Collision) -->
    <!-- ============================================================== -->

    <!-- Human 01: Oncoming Walker (Crimson Sweater, Scale 1.02, Height ~1.75m) -->
    <actor name="human_01_visual">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>model://human/meshes/walk_red.dae</filename>
        <scale>1.02</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk_red.dae</filename>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>0</delay_start>
        <auto_start>false</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint>
            <time>0</time>
            <pose>4.0 0.0 1.02 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>1</time>
            <pose>4.0 0.0 1.02 0 0 3.14159</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <model name="human_01_proxy">
      <pose>4.0 0.0 0.85 0 0 3.14159</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
    </model>

    <!-- Human 02: Counter-flow Walker (Royal Blue Jacket, Scale 0.95, Height ~1.63m) -->
    <actor name="human_02_visual">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>model://human/meshes/walk_blue.dae</filename>
        <scale>0.95</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk_blue.dae</filename>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>0</delay_start>
        <auto_start>false</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint>
            <time>0</time>
            <pose>-8.0 -1.2 0.95 0 0 0.196</pose>
          </waypoint>
          <waypoint>
            <time>1</time>
            <pose>-8.0 -1.2 0.95 0 0 0.196</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <model name="human_02_proxy">
      <pose>-8.0 -1.2 0.80 0 0 0.196</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.26</radius>
              <length>1.60</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
    </model>

    <!-- Human 03: Orthogonal Crossing Walker (Amber Orange, Scale 1.06, Height ~1.82m) -->
    <actor name="human_03_visual">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>model://human/meshes/walk_orange.dae</filename>
        <scale>1.06</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk_orange.dae</filename>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>0</delay_start>
        <auto_start>false</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint>
            <time>0</time>
            <pose>-3.0 -3.0 1.06 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>1</time>
            <pose>-3.0 -3.0 1.06 0 0 1.5708</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <model name="human_03_proxy">
      <pose>-3.0 -3.0 0.875 0 0 1.5708</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.29</radius>
              <length>1.75</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
    </model>

    <!-- Human 04: Diagonal Crossing Walker (Classic Green Sweater, Scale 1.00, Height ~1.72m) -->
    <actor name="human_04_visual">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>model://human/meshes/walk.dae</filename>
        <scale>1.00</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk.dae</filename>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>0</delay_start>
        <auto_start>false</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint>
            <time>0</time>
            <pose>1.0 2.5 1.00 0 0 -2.63</pose>
          </waypoint>
          <waypoint>
            <time>1</time>
            <pose>1.0 2.5 1.00 0 0 -2.63</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <model name="human_04_proxy">
      <pose>1.0 2.5 0.85 0 0 -2.63</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
    </model>

  </world>
</sdf>
