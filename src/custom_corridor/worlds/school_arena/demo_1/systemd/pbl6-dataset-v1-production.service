ExecStartPre=/usr/bin/python3 -m dataset_production.service_preflight
ExecStart=/usr/bin/python3 /home/haduckien/nav_ws/src/custom_corridor/worlds/school_arena/demo_1/produce_dataset_v1.py --config /home/haduckien/nav_ws/src/custom_corridor/worlds/school_arena/demo_1/configs/dataset_v1.yaml --resume
