          <geometry>
            <box>
              <size>60.000 17.000 0.100</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>60.000 17.000 0.100</size>
            </box>
          </geometry>

          <material>
            <ambient>0.82 0.82 0.82 1.0</ambient>
            <diffuse>0.82 0.82 0.82 1.0</diffuse>
          </material>
        </visual>

      </link>
    </model>

