            </cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.35 0.20 1</ambient>
            <diffuse>0.90 0.35 0.20 1</diffuse>
          </material>
        </visual>

        <visual name="head_visual">
          <pose>0 0 0.62 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.18</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.58 1</ambient>
            <diffuse>0.95 0.75 0.58 1</diffuse>
          </material>
        </visual>

        <!-- Small forward marker so heading is visible in Gazebo.
             +X of the model is the walking direction. -->
        <visual name="heading_marker">
          <pose>0.25 0 0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.95 0.10 1</ambient>
            <diffuse>0.95 0.95 0.10 1</diffuse>
          </material>
        </visual>


      </link>

    </model>
