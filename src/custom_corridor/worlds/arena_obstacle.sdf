<?xml version="1.0"?>
<sdf version="1.9">
  <world name="arena_obstacle">

    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Scene and Physics Optimization -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sensors -->
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>24.0 14.0 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>24.0 14.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 0.0 -0.05 0 0 0</pose>
    </model>

    <!-- Perimeter Boundary Walls (10m wide, 20m long) -->
    
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-15.0 0.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>5.0 0.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 -5.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 5.0 1.0 0 0 0</pose>
    </model>

    <!-- Static Obstacles -->
    
    <model name="static_box_A">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 1.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-9.0 1.8 1.0 0 0 0</pose>
    </model>
    
    <model name="static_cylinder_B">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-8.0 -2.2 1.0 0 0 0</pose>
    </model>
    
    <model name="static_box_C">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 0.8 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-3.0 -2.0 1.0 0 0 0</pose>
    </model>
    
    <model name="static_cylinder_D">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-2.0 2.0 1.0 0 0 0</pose>
    </model>

    <!-- Dynamic Walking Pedestrian (Actor) -->
    <actor name="human_actor">
      <skin>
        <filename>model://human/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="1.0">
          <waypoint>
            <time>0.0</time>
            <pose>1.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>10.0</time>
            <pose>-6.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
          <!-- Turnaround at -6.0 -->
          <waypoint>
            <time>10.4</time>
            <pose>-6.0 0.0 1.0 0 0 2.3562</pose>
          </waypoint>
          <waypoint>
            <time>10.8</time>
            <pose>-6.0 0.0 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>11.2</time>
            <pose>-6.0 0.0 1.0 0 0 0.7854</pose>
          </waypoint>
          <waypoint>
            <time>11.5</time>
            <pose>-6.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <!-- Return walk -->
          <waypoint>
            <time>21.5</time>
            <pose>1.0 0.0 1.0 0 0 0.0</pose>
          </waypoint>
          <!-- Turnaround at 1.0 -->
          <waypoint>
            <time>21.9</time>
            <pose>1.0 0.0 1.0 0 0 0.7854</pose>
          </waypoint>
          <waypoint>
            <time>22.3</time>
            <pose>1.0 0.0 1.0 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>22.7</time>
            <pose>1.0 0.0 1.0 0 0 2.3562</pose>
          </waypoint>
          <waypoint>
            <time>23.0</time>
            <pose>1.0 0.0 1.0 0 0 3.14159</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Physical collision & ground-truth tracking for Nav2 / LiDAR -->
    <model name="dynamic_obstacle">
      <pose>1.0 0.0 0.85 0 0 3.14159</pose>
      <self_collide>false</self_collide>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
      <plugin filename="liboscillating_obstacle_system.so"
              name="custom_corridor::OscillatingObstacle">
        <min_x>-6.0</min_x>
        <max_x>1.0</max_x>
        <speed>0.7</speed>
        <y>0.0</y>
        <z>0.85</z>
        <default_mode>human</default_mode>
      </plugin>
    </model>

    <!-- Physical Industrial Object (Cylinder / Pillar for Object mode) -->
    <model name="dynamic_object">
      <pose>1.0 0.0 -50.0 0 0 3.14159</pose>
      <self_collide>false</self_collide>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.50</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.45 0.0 1</ambient>
            <diffuse>1.0 0.45 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
