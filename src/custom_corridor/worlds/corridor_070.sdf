<?xml version="1.0"?>
<sdf version="1.9">
  <world name="corridor_0.70">

    <gravity>0 0 -9.81</gravity>

    <!-- Physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>

    <!-- Ground -->
    
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>34.0 10.0 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>34.0 10.0 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0.0 0.0 -0.05 0 0 0</pose>
    </model>
    

    <!-- Left continuous wall -->
    
    <model name="left_wall">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30.0 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30.0 0.1 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>0.0 -0.39999999999999997 1.0 0 0 0</pose>
    </model>
    

    <!-- Right wall: segment before recess -->
    
    <model name="right_wall_front">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>16.4 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>16.4 0.1 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-6.800000000000001 0.39999999999999997 1.0 0 0 0</pose>
    </model>
    

    <!-- Right wall: segment after recess -->
    
    <model name="right_wall_back">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12.4 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>12.4 0.1 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>8.8 0.39999999999999997 1.0 0 0 0</pose>
    </model>
    

    <!-- Recess side walls -->
    
    <model name="recess_side_left">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>1.3499999999999999 0.6499999999999999 1.0 0 0 0</pose>
    </model>
    

    
    <model name="recess_side_right">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.6 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>2.65 0.6499999999999999 1.0 0 0 0</pose>
    </model>
    

    <!-- Recess back wall -->
    
    <model name="recess_back">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 0.1 2.0</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 0.1 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>2.0 1.0 1.0 0 0 0</pose>
    </model>
    

    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 -0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- ============================================================== -->
    <!-- RVO2 Social Navigation System Plugin for 0.70m Corridor        -->
    <!-- ============================================================== -->
    <plugin
      filename="librvo2_human_system.so"
      name="custom_corridor::RVO2HumanSystem">
      <human_count>1</human_count>
      <robot_name>burger</robot_name>
      <robot_radius>0.28</robot_radius>
      <human_radius>0.28</human_radius>
      <corridor_mode>true</corridor_mode>
      <corridor_half_width>0.35</corridor_half_width>
      <recess_x_min>1.35</recess_x_min>
      <recess_x_max>2.65</recess_x_max>
      <recess_x_center>2.00</recess_x_center>
      <recess_y>0.65</recess_y>
      <recess_approach_dist>3.5</recess_approach_dist>
      <recess_threshold>0.40</recess_threshold>
      <politeness_balance_point>0.60</politeness_balance_point>
      <randomize_politeness>true</randomize_politeness>
      <visual_z>1.02</visual_z>
      <proxy_z>0.85</proxy_z>
    </plugin>

    <!-- Human 01: Oncoming Walker (Crimson Sweater, Scale 1.02, Height ~1.75m) -->
    <actor name="human_01_visual">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>model://human/meshes/walk_red.dae</filename>
        <scale>1.02</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk_red.dae</filename>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>0</delay_start>
        <auto_start>false</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint>
            <time>0</time>
            <pose>0 0 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>1</time>
            <pose>0 0 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <model name="human_01_proxy">
      <pose>5.0 0.0 0.85 0 0 3.14159</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.001</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <transparency>1.0</transparency>
        </visual>
      </link>
    </model>

  </world>
</sdf>
