<?xml version="1.0"?>
<sdf version="1.9">
  <world name="arena_dataset">

    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- ============================================================== -->
    <!-- RVO2 Social Navigation System Plugin                           -->
    <!-- ============================================================== -->
    <plugin
        filename="librvo2_human_system.so"
        name="custom_corridor::RVO2HumanSystem">
      <human_count>24</human_count>
      <robot_name>mecanum_robot</robot_name>
      <robot_radius>0.16</robot_radius>
      <human_radius>0.22</human_radius>
      <scenario_topic>/multi_human/scenario</scenario_topic>
      <command_topic>/multi_human/command</command_topic>
      <ground_truth_topic>/rvo2_human/ground_truth</ground_truth_topic>
      <visual_z>1.0</visual_z>
      <proxy_z>0.85</proxy_z>
      <hidden_z>-50.0</hidden_z>
      <politeness_balance_point>0.60</politeness_balance_point>
      <randomize_politeness>true</randomize_politeness>
    </plugin>

    <!-- Scene and Physics Optimization -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sensors -->
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>24.0 14.0 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>24.0 14.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 0.0 -0.05 0 0 0</pose>
    </model>

    <!-- Perimeter Boundary Walls (10m wide, 20m long) -->
    
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-15.0 0.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>5.0 0.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 -5.0 1.0 0 0 0</pose>
    </model>
    
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20.4 0.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-5.0 5.0 1.0 0 0 0</pose>
    </model>

    <!-- Static Obstacles -->
    
    <model name="static_box_A">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 1.2 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 1.2 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-9.0 1.8 1.0 0 0 0</pose>
    </model>
    
    <model name="static_cylinder_B">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-8.0 -2.2 1.0 0 0 0</pose>
    </model>
    
    <model name="static_box_C">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.5 0.8 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.5 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.2 1</ambient>
            <diffuse>0.8 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-3.0 -2.0 1.0 0 0 0</pose>
    </model>
    
    <model name="static_cylinder_D">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>2.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-2.0 2.0 1.0 0 0 0</pose>
    </model>
    <!-- Human 01: Realistic 3D Human Actor (Warehouse Representation) -->
    <actor name="human_01_visual">
      <pose>0 0 -50 0 0 0</pose>
      <skin>
        <filename>model://human/meshes/walk_blue.dae</filename>
        <scale>1.00</scale>
      </skin>
      <animation name="walk">
        <filename>model://human/meshes/walk_blue.dae</filename>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>0</delay_start>
        <auto_start>false</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint>
            <time>0</time>
            <pose>0 0 -50 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>1</time>
            <pose>0 0 -50 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Human 01: Collision proxy (cylinder) -->
    <model name="human_01_proxy">
      <pose>0 0 -50 0 0 0</pose>
      <static>false</static>
      <self_collide>false</self_collide>
      <link name="body">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>1.70</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="body_visual">
